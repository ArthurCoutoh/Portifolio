@page "/"

<PageTitle>Portfólios — Arthur & Alicy</PageTitle>

<div class="hub-page">

    <!-- Partículas decorativas -->
    <div class="hub-particles" aria-hidden="true">
        @for (int i = 1; i <= 18; i++)
        {
            <div class="hub-particle" style="--i:@i"></div>
        }
    </div>

    <!-- Cabeçalho do hub -->
    <header class="hub-header">
        <div class="hub-logo-badge">
            <span class="hub-logo-icon">✦</span>
        </div>
        <h1 class="hub-title">
            <span class="hub-title-line">Portfólios</span>
            <span class="hub-title-highlight">Coop</span>
        </h1>
        <p class="hub-subtitle">Escolha um portfólio para explorar</p>
        <div class="hub-divider"></div>
    </header>

    <!-- Cards dos portfólios -->
    <main class="hub-cards" id="portfolios-grid">

        <!-- Card Arthur -->
        <a href="/arthur" class="hub-card hub-card--arthur" id="card-arthur" aria-label="Acessar portfólio do Arthur Couto">
            <div class="hub-card__glow"></div>
            <div class="hub-card__border-top"></div>

            <div class="hub-card__icon" aria-hidden="true">
                <span class="hub-card__icon-ring"></span>
                ⚔️
            </div>

            <div class="hub-card__body">
                <span class="hub-card__tag">Dev · Blazor · C#</span>
                <h2 class="hub-card__name">Arthur Couto</h2>
                <p class="hub-card__desc">
                    Desenvolvedor .NET apaixonado por C# e Blazor. Estudante do IFRO,
                    construindo projetos reais e sempre aprendendo algo novo.
                </p>

                <ul class="hub-card__skills" aria-label="Habilidades de Arthur">
                    <li class="hub-skill hub-skill--cyan"><i class="fas fa-code" aria-hidden="true"></i> C#</li>
                    <li class="hub-skill hub-skill--purple"><i class="fas fa-layer-group" aria-hidden="true"></i> Blazor</li>
                    <li class="hub-skill hub-skill--gold"><i class="fab fa-git-alt" aria-hidden="true"></i> Git</li>
                </ul>
            </div>

            <div class="hub-card__footer">
                <span class="hub-card__cta">
                    Explorar portfólio
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </span>
            </div>
        </a>

        <!-- Divisor central -->
        <div class="hub-separator" aria-hidden="true">
            <div class="hub-separator__line"></div>
            <div class="hub-separator__dot">
                <span>VS</span>
            </div>
            <div class="hub-separator__line"></div>
        </div>

        <!-- Card Alicy -->
        <a href="/alicy" class="hub-card hub-card--alicy" id="card-alicy" aria-label="Acessar portfólio da Alicy Araujo">
            <div class="hub-card__glow hub-card__glow--alicy"></div>
            <div class="hub-card__border-top hub-card__border-top--alicy"></div>

            <div class="hub-card__icon" aria-hidden="true">
                <span class="hub-card__icon-ring hub-card__icon-ring--alicy"></span>
                🌸
            </div>

            <div class="hub-card__body">
                <span class="hub-card__tag hub-card__tag--alicy">Dev · Web · Design</span>
                <h2 class="hub-card__name">Alicy Araujo</h2>
                <p class="hub-card__desc">
                    Desenvolvedora web criativa com foco em interfaces bonitas e funcionais.
                    Explorando tecnologias modernas e design centrado no usuário.
                </p>

                <ul class="hub-card__skills" aria-label="Habilidades de Alicy">
                    <li class="hub-skill hub-skill--pink"><i class="fab fa-html5" aria-hidden="true"></i> HTML</li>
                    <li class="hub-skill hub-skill--rose"><i class="fab fa-css3-alt" aria-hidden="true"></i> CSS</li>
                    <li class="hub-skill hub-skill--violet"><i class="fas fa-palette" aria-hidden="true"></i> UI/UX</li>
                </ul>
            </div>

            <div class="hub-card__footer">
                <span class="hub-card__cta hub-card__cta--alicy">
                    Explorar portfólio
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </span>
            </div>
        </a>

    </main>

    <!-- Rodapé -->
    <footer class="hub-footer">
        <p>Feito com <span aria-label="amor">❤️</span> · IFRO Coop · 2026</p>
    </footer>

</div>

<style>
    /* ── Hub Page Layout ── */
    .hub-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        position: relative;
        overflow: hidden;
        gap: 2.5rem;
    }

    /* ── Particles ── */
    .hub-particles {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .hub-particle {
        position: absolute;
        width: calc(3px + (var(--i) * 0.3px));
        height: calc(3px + (var(--i) * 0.3px));
        border-radius: 50%;
        opacity: 0.5;
        background: hsl(calc(var(--i) * 25), 80%, 65%);
        top: calc(var(--i) * 5.5%);
        left: calc((var(--i) * 37) % 100 * 1%);
        animation: hubFloat calc(6s + var(--i) * 0.5s) ease-in-out infinite alternate;
        animation-delay: calc(var(--i) * -0.4s);
    }

    @@keyframes hubFloat {
        from { transform: translateY(0) scale(1); opacity: 0.35; }
        to   { transform: translateY(-30px) scale(1.3); opacity: 0.65; }
    }

    /* ── Header ── */
    .hub-header {
        text-align: center;
        position: relative;
        z-index: 1;
        animation: hubFadeDown 0.7s ease both;
    }

    .hub-logo-badge {
        width: 70px;
        height: 70px;
        margin: 0 auto 1.2rem;
        background: linear-gradient(135deg, #8b5cf6, #00d4ff);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.5), 0 8px 0 #4c1d95;
        animation: hubPulse 3s ease-in-out infinite;
    }

    @@keyframes hubPulse {
        0%, 100% { box-shadow: 0 0 30px rgba(139,92,246,0.5), 0 8px 0 #4c1d95; }
        50%       { box-shadow: 0 0 50px rgba(139,92,246,0.9), 0 8px 0 #4c1d95; }
    }

    .hub-logo-icon { color: white; font-size: 2rem; line-height: 1; }

    .hub-title {
        font-family: var(--font-title);
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .hub-title-line { color: var(--text-primary); }

    .hub-title-highlight {
        background: linear-gradient(135deg, #8b5cf6, #00d4ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hub-subtitle {
        font-size: 1.05rem;
        color: var(--text-secondary);
        letter-spacing: 0.5px;
        margin-bottom: 1.5rem;
    }

    .hub-divider {
        width: 80px;
        height: 3px;
        background: linear-gradient(90deg, #8b5cf6, #00d4ff);
        border-radius: 2px;
        margin: 0 auto;
    }

    /* ── Cards Grid ── */
    .hub-cards {
        display: flex;
        gap: 2rem;
        align-items: stretch;
        position: relative;
        z-index: 1;
        animation: hubFadeUp 0.8s 0.2s ease both;
        flex-wrap: wrap;
        justify-content: center;
        width: 100%;
        max-width: 900px;
    }

    /* ── Individual Card ── */
    .hub-card {
        flex: 1 1 320px;
        max-width: 380px;
        background: linear-gradient(160deg, rgba(20,24,36,0.95), rgba(12,16,28,0.98));
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 24px;
        padding: 2.5rem 2rem 1.8rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1),
                    box-shadow 0.35s ease,
                    border-color 0.35s ease;
        box-shadow: 0 10px 40px rgba(0,0,0,0.4), 0 1px 0 rgba(255,255,255,0.05) inset;
    }

    .hub-card:hover {
        transform: translateY(-10px) scale(1.02);
    }

    /* Arthur hover */
    .hub-card--arthur:hover {
        border-color: rgba(0, 212, 255, 0.4);
        box-shadow: 0 20px 60px rgba(0,212,255,0.15), 0 0 0 1px rgba(0,212,255,0.2);
    }

    /* Alicy hover */
    .hub-card--alicy:hover {
        border-color: rgba(236, 72, 153, 0.4);
        box-shadow: 0 20px 60px rgba(236,72,153,0.15), 0 0 0 1px rgba(236,72,153,0.2);
    }

    /* Glow overlay */
    .hub-card__glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 0%, rgba(0,212,255,0.06) 0%, transparent 70%);
        pointer-events: none;
        transition: opacity 0.4s;
        opacity: 0;
    }

    .hub-card__glow--alicy {
        background: radial-gradient(ellipse at 50% 0%, rgba(236,72,153,0.08) 0%, transparent 70%);
    }

    .hub-card:hover .hub-card__glow { opacity: 1; }

    /* Top border accent */
    .hub-card__border-top {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #8b5cf6, #00d4ff);
        border-radius: 24px 24px 0 0;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }

    .hub-card__border-top--alicy {
        background: linear-gradient(90deg, #ec4899, #f97316);
    }

    .hub-card:hover .hub-card__border-top { transform: scaleX(1); }

    /* Icon */
    .hub-card__icon {
        font-size: 3.2rem;
        margin-bottom: 1.5rem;
        position: relative;
        width: fit-content;
        line-height: 1;
        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.5));
        transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
    }

    .hub-card:hover .hub-card__icon {
        transform: scale(1.15) rotate(-5deg);
    }

    .hub-card__icon-ring {
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 1.5px solid rgba(0,212,255,0.25);
        animation: iconSpin 8s linear infinite;
        display: block;
    }

    .hub-card__icon-ring--alicy {
        border-color: rgba(236,72,153,0.25);
    }

    @@keyframes iconSpin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
    }

    /* Body */
    .hub-card__body { flex: 1; }

    .hub-card__tag {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--color-cyan);
        border: 1px solid rgba(0,212,255,0.25);
        background: rgba(0,212,255,0.06);
        padding: 0.25rem 0.75rem;
        border-radius: 100px;
        margin-bottom: 0.75rem;
    }

    .hub-card__tag--alicy {
        color: #ec4899;
        border-color: rgba(236,72,153,0.25);
        background: rgba(236,72,153,0.06);
    }

    .hub-card__name {
        font-family: var(--font-title);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
        line-height: 1.1;
    }

    .hub-card__desc {
        font-size: 0.92rem;
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 1.5rem;
    }

    /* Skills chips */
    .hub-card__skills {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .hub-skill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.75rem;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1px solid;
        transition: transform 0.2s ease;
    }

    .hub-skill:hover { transform: translateY(-2px); }

    .hub-skill--cyan   { color: #00d4ff; border-color: rgba(0,212,255,0.3);   background: rgba(0,212,255,0.08); }
    .hub-skill--purple { color: #a78bfa; border-color: rgba(167,139,250,0.3); background: rgba(167,139,250,0.08); }
    .hub-skill--gold   { color: #f59e0b; border-color: rgba(245,158,11,0.3);  background: rgba(245,158,11,0.08); }
    .hub-skill--pink   { color: #f472b6; border-color: rgba(244,114,182,0.3); background: rgba(244,114,182,0.08); }
    .hub-skill--rose   { color: #fb7185; border-color: rgba(251,113,133,0.3); background: rgba(251,113,133,0.08); }
    .hub-skill--violet { color: #c084fc; border-color: rgba(192,132,252,0.3); background: rgba(192,132,252,0.08); }

    /* Footer CTA */
    .hub-card__footer {
        padding-top: 1.2rem;
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .hub-card__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-title);
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-cyan);
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: gap 0.25s ease, color 0.25s ease;
    }

    .hub-card__cta--alicy { color: #ec4899; }

    .hub-card:hover .hub-card__cta { gap: 0.9rem; }

    .hub-card__cta i {
        font-size: 0.85rem;
        transition: transform 0.25s ease;
    }

    .hub-card:hover .hub-card__cta i { transform: translateX(4px); }

    /* ── Central Separator ── */
    .hub-separator {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        flex-shrink: 0;
        padding: 1rem 0;
    }

    .hub-separator__line {
        width: 2px;
        flex: 1;
        min-height: 60px;
        background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.08), transparent);
        border-radius: 2px;
    }

    .hub-separator__dot {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8b5cf6, #ec4899);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-title);
        font-size: 0.75rem;
        font-weight: 700;
        color: white;
        letter-spacing: 1px;
        box-shadow: 0 0 20px rgba(139,92,246,0.4);
        animation: hubPulseDot 2.5s ease-in-out infinite;
        flex-shrink: 0;
    }

    @@keyframes hubPulseDot {
        0%, 100% { transform: scale(1);    box-shadow: 0 0 20px rgba(139,92,246,0.4); }
        50%       { transform: scale(1.1); box-shadow: 0 0 35px rgba(236,72,153,0.6); }
    }

    /* ── Footer ── */
    .hub-footer {
        font-size: 0.82rem;
        color: var(--text-muted);
        text-align: center;
        position: relative;
        z-index: 1;
        animation: hubFadeUp 0.8s 0.4s ease both;
        letter-spacing: 0.5px;
    }

    /* ── Animations ── */
    @@keyframes hubFadeDown {
        from { opacity: 0; transform: translateY(-24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes hubFadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Responsive ── */
    @@media (max-width: 720px) {
        .hub-cards { flex-direction: column; align-items: center; }

        .hub-separator {
            flex-direction: row;
            width: 100%;
            max-width: 340px;
            padding: 0 1rem;
        }

        .hub-separator__line {
            height: 2px;
            width: auto;
            min-height: unset;
            flex: 1;
        }

        .hub-card { max-width: 100%; width: 100%; }
    }
</style>