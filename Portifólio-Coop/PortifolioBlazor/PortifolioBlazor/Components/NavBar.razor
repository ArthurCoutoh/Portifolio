@inject NavigationManager Nav
@implements IDisposable

<nav class="navbar" id="main-navbar">

    <!-- Brand / Logo -->
    <a href="/" class="navbar-brand" id="nav-brand" title="Voltar ao menu principal">
        <div class="navbar-logo">
            @if (CurrentSection == "arthur")
            {
                <span>AC</span>
            }
            else if (CurrentSection == "alicy")
            {
                <span>AA</span>
            }
            else
            {
                <span>✦</span>
            }
        </div>
        @if (CurrentSection == "arthur")
        {
            <span class="navbar-name">Arthur<span>Couto</span></span>
        }
        else if (CurrentSection == "alicy")
        {
            <span class="navbar-name alicy-name">Alicy<span>Araujo</span></span>
        }
        else
        {
            <span class="navbar-name">Portfólios<span> Coop</span></span>
        }
    </a>

    <!-- Links de navegação contextuais -->
    <ul class="navbar-links" id="nav-links-list">
        @if (CurrentSection == "arthur")
        {
            <li><a href="/arthur"         class="@IsActive("/arthur")"          id="nav-arthur-home">    <i class="fas fa-house"></i> Início</a></li>
            <li><a href="/arthur/projetos" class="@IsActive("/arthur/projetos")" id="nav-arthur-projects"><i class="fas fa-code"></i> Projetos</a></li>
            <li><a href="/arthur/contato" class="btn navbar-cta"                id="nav-arthur-contact"> <i class="fas fa-paper-plane"></i> Contato</a></li>
        }
        else if (CurrentSection == "alicy")
        {
            <li><a href="/alicy"           class="@IsActive("/alicy")"           id="nav-alicy-home">    <i class="fas fa-house"></i> Início</a></li>
            <li><a href="/alicy/historia"  class="@IsActive("/alicy/historia")"  id="nav-alicy-history"> <i class="fas fa-book-open"></i> História</a></li>
            <li><a href="/alicy/curriculo" class="@IsActive("/alicy/curriculo")" id="nav-alicy-resume">  <i class="fas fa-file-alt"></i> Currículo</a></li>
            <li><a href="/alicy/contato"   class="btn navbar-cta navbar-cta--alicy" id="nav-alicy-contact"><i class="fas fa-paper-plane"></i> Contato</a></li>
        }
        else
        {
            <li><a href="/" class="active" id="nav-hub-home"><i class="fas fa-house"></i> Início</a></li>
            <li><a href="/arthur"          id="nav-hub-arthur"><i class="fas fa-sword"></i>  Arthur</a></li>
            <li><a href="/alicy"           id="nav-hub-alicy" ><i class="fas fa-star"></i>   Alicy</a></li>
        }
    </ul>

    <!-- Toggle mobile -->
    <button class="navbar-toggle" id="nav-toggle" @onclick="ToggleMobileMenu" aria-label="Abrir menu">
        <i class="fas @(menuOpen ? "fa-times" : "fa-bars")"></i>
    </button>
</nav>

<!-- Menu mobile overlay -->
@if (menuOpen)
{
    <div class="mobile-menu-overlay" @onclick="ToggleMobileMenu">
        <ul class="mobile-menu" @onclick:stopPropagation>
            @if (CurrentSection == "arthur")
            {
                <li><a href="/arthur"          @onclick="ToggleMobileMenu"><i class="fas fa-house"></i> Início</a></li>
                <li><a href="/arthur/projetos" @onclick="ToggleMobileMenu"><i class="fas fa-code"></i> Projetos</a></li>
                <li><a href="/arthur/contato"  @onclick="ToggleMobileMenu"><i class="fas fa-paper-plane"></i> Contato</a></li>
            }
            else if (CurrentSection == "alicy")
            {
                <li><a href="/alicy"           @onclick="ToggleMobileMenu"><i class="fas fa-house"></i> Início</a></li>
                <li><a href="/alicy/historia"  @onclick="ToggleMobileMenu"><i class="fas fa-book-open"></i> História</a></li>
                <li><a href="/alicy/curriculo" @onclick="ToggleMobileMenu"><i class="fas fa-file-alt"></i> Currículo</a></li>
                <li><a href="/alicy/contato"   @onclick="ToggleMobileMenu"><i class="fas fa-paper-plane"></i> Contato</a></li>
            }
            else
            {
                <li><a href="/arthur" @onclick="ToggleMobileMenu"><i class="fas fa-sword"></i> Arthur Couto</a></li>
                <li><a href="/alicy"  @onclick="ToggleMobileMenu"><i class="fas fa-star"></i>  Alicy Araujo</a></li>
            }
            <li class="mobile-menu-back">
                <a href="/" @onclick="ToggleMobileMenu"><i class="fas fa-th-large"></i> Todos os portfólios</a>
            </li>
        </ul>
    </div>
}

<style>
    /* ── Alicy navbar variant ── */
    .alicy-name span { color: #ec4899 !important; }

    .navbar-cta--alicy {
        background: linear-gradient(135deg, #ec4899, #f97316) !important;
        color: white !important;
        box-shadow: 0 0 15px rgba(236, 72, 153, 0.35) !important;
    }

    .navbar-cta--alicy:hover {
        box-shadow: 0 0 28px rgba(236, 72, 153, 0.65) !important;
    }

    /* ── Mobile back item ── */
    .mobile-menu-back {
        border-top: 1px solid rgba(255,255,255,0.08);
        padding-top: 0.5rem;
        margin-top: 0.5rem;
    }

    .mobile-menu-back a {
        font-size: 1rem !important;
        color: var(--text-muted) !important;
        letter-spacing: 1px !important;
    }

    .mobile-menu-back a:hover { color: var(--color-gold) !important; }

    /* ── Mobile overlay ── */
    .mobile-menu-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 14, 26, 0.92);
        backdrop-filter: blur(12px);
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.2s ease;
    }

    .mobile-menu {
        list-style: none;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .mobile-menu a {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.8rem 2rem;
        font-family: var(--font-title);
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        text-decoration: none;
        letter-spacing: 2px;
        transition: var(--transition);
    }

    .mobile-menu a:hover  { color: var(--color-gold); }
    .mobile-menu i { color: var(--color-cyan); font-size: 1rem; }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* ── Responsive: hide desktop links on mobile ── */
    @@media (max-width: 680px) {
        .navbar-links  { display: none; }
        .navbar-toggle { display: flex; }
    }
</style>

@code {
    private bool   menuOpen   = false;
    private string currentUrl = string.Empty;

    /// <summary>Retorna "arthur", "alicy" ou "" dependendo da URL atual.</summary>
    private string CurrentSection
    {
        get
        {
            var path = GetPath();
            if (path.StartsWith("/arthur", StringComparison.OrdinalIgnoreCase)) return "arthur";
            if (path.StartsWith("/alicy",  StringComparison.OrdinalIgnoreCase)) return "alicy";
            return "";
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        currentUrl = Nav.Uri;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUrl = e.Location;
        menuOpen   = false;
        StateHasChanged();
    }

    private void ToggleMobileMenu() => menuOpen = !menuOpen;

    private string GetPath() =>
        new Uri(currentUrl).AbsolutePath.TrimEnd('/');

    private string IsActive(string route)
    {
        var path = GetPath();
        return path.Equals(route, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
